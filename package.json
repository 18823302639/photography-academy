{
  "name": "photography-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:weapp": "cd apps/miniprogram && taro build --type weapp",
    "build:weapp:offline": "node scripts/verification/build-weapp-offline.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test packages/photography-core/tests/*.test.ts",
    "verify:s1": "node scripts/verification/run-checks.cjs",
    "verify:s2-photo-input": "node scripts/verification/check-photo-input.cjs",
    "verify:s2-exif-contract": "node scripts/verification/check-photo-input.cjs exif-contract",
    "verify:s2-photo-exif": "node scripts/verification/check-photo-input.cjs photo-exif",
    "verify:t09-file-compat": "node scripts/verification/check-photo-input.cjs file-compat",
    "verify:navigation": "node scripts/verification/check-photo-input.cjs navigation"
  },
  "dependencies": {
    "@tarojs/components": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "7.28.5",
    "@tarojs/cli": "4.3.3",
    "@tarojs/plugin-framework-react": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/webpack5-runner": "4.3.3",
    "@types/react": "18.3.18",
    "babel-preset-taro": "4.3.3",
    "typescript": "5.8.3",
    "webpack": "5.91.0"
  }
}
